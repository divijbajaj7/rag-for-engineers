# Choose ONE provider — set the matching key below.
# The code auto-detects which key is present (see scripts/common.py).

# Option A — OpenAI (students with an OpenAI key): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option B — OpenRouter (one key for Claude, Gemini, GPT, free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides:
#   LLM_PROVIDER=openai        # force a provider if both keys are set (default: openrouter)
#   GENERATION_MODEL=gpt-4o-mini
#   JUDGE_MODEL=gpt-4o-mini
